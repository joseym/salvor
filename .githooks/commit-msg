#!/bin/sh
# commit-msg hook: enforce Conventional Commits for the Salvor project.
#
# Activate once per clone with:
#   git config core.hooksPath .githooks
#
# Dependency-free: only sh builtins plus grep, sed, awk are used.

MSG_FILE="$1"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "commit-msg: no commit message file given" >&2
    exit 1
fi

ALLOWED_TYPES="feat fix docs test refactor perf build ci chore style revert"
SCISSORS_LINE='^# ------------------------ >8 ------------------------$'

# Strip everything from the "scissors" line onward (git appends the diff
# below it when --verbose is used), then strip remaining comment lines.
CLEAN=$(sed "/${SCISSORS_LINE}/,\$d" "$MSG_FILE" | grep -v '^#')

FIRST_LINE=$(printf '%s\n' "$CLEAN" | sed -n '1p')
SECOND_LINE=$(printf '%s\n' "$CLEAN" | sed -n '2p')
TOTAL_LINES=$(printf '%s\n' "$CLEAN" | awk 'END{print NR}')

# Bypass checks entirely for merge commits, fixup!/squash! commits, and
# git's own generated revert commits.
case "$FIRST_LINE" in
    "Merge "*)
        exit 0
        ;;
    "fixup!"*|"squash!"*)
        exit 0
        ;;
    'Revert "'*)
        exit 0
        ;;
esac

# An empty message (or one containing only comments) has no first line to
# validate; reject it explicitly before the checks below.
if [ -z "$FIRST_LINE" ]; then
    echo "commit-msg: commit message is empty (no non-comment first line)" >&2
    echo "Example of a valid message:" >&2
    echo "  feat(core): add event replay engine" >&2
    exit 1
fi

FAIL=0
REASONS=""

fail() {
    FAIL=1
    REASONS="${REASONS}- $1
"
}

LEN=$(printf '%s' "$FIRST_LINE" | awk '{print length}')
if [ "$LEN" -gt 72 ]; then
    fail "first line is $LEN characters, must be at most 72"
fi

HEADER_RE='^([a-zA-Z]+)(\(([^()]*)\))?(!)?: (.*)$'
MATCHED=$(printf '%s' "$FIRST_LINE" | sed -E -n "s/${HEADER_RE}/matched/p")

if [ -z "$MATCHED" ]; then
    fail "first line must look like 'type(scope)!: subject' (missing type or ': ' separator)"
else
    TYPE=$(printf '%s' "$FIRST_LINE" | sed -E "s/${HEADER_RE}/\\1/")
    SCOPE_BLOB=$(printf '%s' "$FIRST_LINE" | sed -E "s/${HEADER_RE}/\\2/")
    SCOPE=$(printf '%s' "$FIRST_LINE" | sed -E "s/${HEADER_RE}/\\3/")
    SUBJECT=$(printf '%s' "$FIRST_LINE" | sed -E "s/${HEADER_RE}/\\5/")

    TYPE_OK=0
    for t in $ALLOWED_TYPES; do
        if [ "$t" = "$TYPE" ]; then
            TYPE_OK=1
        fi
    done
    if [ "$TYPE_OK" -ne 1 ]; then
        fail "type '$TYPE' is not allowed (use one of: feat, fix, docs, test, refactor, perf, build, ci, chore, style, revert)"
    fi

    if [ -n "$SCOPE_BLOB" ]; then
        if ! printf '%s' "$SCOPE" | grep -Eq '^[a-z0-9-]+$'; then
            fail "scope '($SCOPE)' must contain only lowercase letters, digits, and hyphens"
        fi
    fi

    if [ -z "$SUBJECT" ]; then
        fail "subject must not be empty"
    else
        if ! printf '%s' "$SUBJECT" | grep -Eq '^[a-z]'; then
            fail "subject must start with a lowercase letter"
        fi
        if printf '%s' "$SUBJECT" | grep -Eq '\.$'; then
            fail "subject must not end with a period"
        fi
    fi
fi

if [ "$TOTAL_LINES" -gt 1 ] && [ -n "$SECOND_LINE" ]; then
    fail "second line must be blank to separate the subject from the body"
fi

if [ "$FAIL" -eq 1 ]; then
    echo "commit-msg: commit message does not follow Conventional Commits:" >&2
    printf '%s' "$REASONS" >&2
    echo "" >&2
    echo "Example of a valid message:" >&2
    echo "  feat(core): add event replay engine" >&2
    exit 1
fi

exit 0
