/target
/salvor.db*
/findings.txt
# The hero example's default write target when SALVOR_HERO_CLAIMS is unset.
/claims.txt

# A stray self-referential symlink and the personal study material that
# renders from it; neither belongs in the published tree.
/salvor
/.rdm/
/study-guide/

# Installed dependencies, including the examples that now depend on the published packages.
node_modules/
.venv/

# Compiled bytecode from running or importing a Python example; regenerated on
# every run, and never something a reader should be diffing against.
__pycache__/

# Editor config is not tracked in general, but this one file is: it points a
# JSON language server at docs/graph-schema.json, so a graph document gets
# completion and validation on clone rather than after a setup step. A document
# cannot name its own schema (the format rejects unknown fields), so the mapping
# has to live somewhere, and the alternative is every reader configuring it by
# hand. Negated here rather than force-added so `git status` keeps reporting
# edits to it.
!/.vscode/
!/.vscode/settings.json
