{
  "schema_version": 1,
  "nodes": [
    {
      "kind": "tool",
      "payload": {
        "id": "pull_dispute",
        "tool": "lookup_dispute"
      }
    },
    {
      "kind": "branch",
      "payload": {
        "id": "route_by_amount",
        "cases": [
          {
            "name": "escalate",
            "when": {
              "kind": "expression",
              "value": "structuredContent.amount_usd >= 250.0"
            }
          },
          {
            "name": "auto_settle",
            "when": {
              "kind": "expression",
              "value": "structuredContent.amount_usd < 250.0"
            }
          }
        ]
      }
    },
    {
      "kind": "gate",
      "payload": {
        "id": "approve_refund",
        "prompt": "This dispute is at or above the review threshold. Answer with the refund to issue: dispute_id, amount_usd, approver, and an optional note. The run stays parked until you do.",
        "approval_schema": {
          "type": "object",
          "properties": {
            "dispute_id": { "type": "string" },
            "amount_usd": { "type": "number" },
            "approver": { "type": "string" },
            "note": { "type": "string" }
          },
          "required": ["dispute_id", "amount_usd", "approver"]
        }
      }
    },
    {
      "kind": "tool",
      "payload": {
        "id": "settle",
        "tool": "issue_refund"
      }
    },
    {
      "kind": "agent",
      "payload": {
        "id": "notify",
        "agent_hash": "sha256:b7d78fea51de84c04878fee36bf4cbc25299f32829a0deec03f545e4b4aba081"
      }
    },
    {
      "kind": "agent",
      "payload": {
        "id": "small_claims",
        "agent_hash": "sha256:e08f574704bad055401cba7f6a289a903e6f2972a2d7a088be426f0533b54f13"
      }
    }
  ],
  "edges": [
    { "from": "pull_dispute", "to": "route_by_amount" },
    { "from": "route_by_amount", "to": "approve_refund", "label": "escalate" },
    { "from": "approve_refund", "to": "settle" },
    { "from": "settle", "to": "notify" },
    { "from": "route_by_amount", "to": "small_claims", "label": "auto_settle" }
  ]
}
