{
  "name": "@salvor-run/client",
  "version": "0.9.2",
  "description": "Thin TypeScript client for the Salvor durable-agent control plane",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "default": "./dist/langchain/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.teach.md",
    "!dist/**/*.teach.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0 <2",
    "langchain": ">=1.0.0 <2"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "langchain": "^1.5.10",
    "typescript": "^5.4.0"
  }
}
